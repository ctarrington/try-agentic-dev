# Stage 1 — install deps in the official Node image (avoids apt-get in Chrome image)
FROM node:lts-slim AS build

ENV CYPRESS_CACHE_FOLDER=/build/.cypress-cache

WORKDIR /build
COPY package*.json ./
RUN npm ci

# Stage 2 — Chrome image with Node.js copied in (no apt-get needed)
FROM lscr.io/linuxserver/chrome

COPY --from=build /usr/local/bin/node          /usr/local/bin/node
COPY --from=build /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

ENV CYPRESS_CACHE_FOLDER=/app/.cypress-cache

WORKDIR /app

# Only node_modules and the Cypress binary are baked in;
# cypress/, cypress.config.ts, tsconfig files, and test-output are volume-mounted
COPY --from=build /build/node_modules    ./node_modules
COPY --from=build /build/.cypress-cache ./.cypress-cache

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
